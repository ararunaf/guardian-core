{
  "name": "@iaeasy/guardian-core",
  "version": "1.0.0",
  "description": "Guardian Core — independent, product-agnostic engineering intelligence platform for the IAeasy portfolio",
  "type": "module",
  "main": "./index.ts",
  "types": "./index.ts",
  "exports": {
    ".": "./index.ts",
    "./sdk": "./sdk/index.ts",
    "./public-api": "./public-api/index.ts",
    "./certification": "./certification/index.ts"
  },
  "files": [
    "**/*"
  ],
  "scripts": {
    "build": "tsc --noEmit -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "lint": "node scripts/gai08c-lint.cjs",
    "cert:gai08c": "vitest run tests/gai08c_independent_certification.test.ts"
  },
  "keywords": ["guardian", "iaeasy", "observability", "engineering-intelligence"],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ararunaf/guardian-core.git"
  },
  "peerDependencies": {
    "react": "^18.0.0"
  },
  "peerDependenciesMeta": {
    "react": { "optional": true }
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "react": "^18.3.1",
    "typescript": "^5.8.0",
    "vitest": "^3.0.0"
  }
}